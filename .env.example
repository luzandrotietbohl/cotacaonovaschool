# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5
# Necessario apenas se a chave for identity-linked (erro 400 sem ele)
ANTHROPIC_WORKSPACE_ID=

# Gmail
GMAIL_USER=sua-conta@gmail.com
GMAIL_QUERY=is:unread -label:cotador-processado

# Google Sheets - lida por conta de servico (service_account.json na raiz).
# A planilha precisa estar compartilhada com o email da conta de servico.
SHEET_ID=
SHEET_ABA=TABELA_ROTAS

# rascunho | enviar
MODO_RESPOSTA=rascunho
INTERVALO_SEGUNDOS=120

# Exigir peso do cliente? A tarifa nao cobra por peso, mas ele valida
# PESO_MAXIMO_VOLUME_KG. false = nao pergunta peso ao cliente.
EXIGIR_PESO=true

# SMTP (envio das respostas). A senha de app e gerada por voce em
# https://myaccount.google.com/apppasswords (exige verificacao em 2 etapas).
# Sao 16 caracteres; espacos sao ignorados pelo codigo.
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=465
SMTP_USUARIO=sua-conta@gmail.com
SMTP_SENHA_APP=
# Opcional: nome exibido no campo De
SMTP_REMETENTE=Nova School <sua-conta@gmail.com>

# IMAP (leitura da caixa) - usa o mesmo SMTP_USUARIO e SMTP_SENHA_APP
IMAP_HOST=imap.gmail.com
IMAP_PORTA=993
